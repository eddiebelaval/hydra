<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.id8labs.claude-memory-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/eddiebelaval/.hydra/tools/claude-memory-snapshot.sh</string>
    </array>

    <!-- Nightly at 01:43. Off-minute on purpose, and deliberately BEFORE the 02:00
         EOD bots so a memory snapshot is never racing them. Commits only; never pushes.
         Halts instead of committing if a run would delete more than MAX_DELETIONS files. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>43</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/eddiebelaval</string>
        <key>MAX_DELETIONS</key>
        <string>10</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/eddiebelaval/.hydra/logs/claude-memory-snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/eddiebelaval/.hydra/logs/claude-memory-snapshot.err</string>
</dict>
</plist>
